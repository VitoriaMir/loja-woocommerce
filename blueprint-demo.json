			"path": "/wordpress/wp-content/mu-plugins/fv-loja/contato.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/mu-plugins/fv-loja/contato.php"
			}
		},
		{
