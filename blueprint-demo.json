			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/mu-plugins/fv-loja/desempenho.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/fv-loja/frete.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/mu-plugins/fv-loja/frete.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/fv-loja/parcelas.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/mu-plugins/fv-loja/parcelas.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/fv-loja/seguranca.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/mu-plugins/fv-loja/seguranca.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/fv-loja/seo.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/mu-plugins/fv-loja/seo.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/fv-loja.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/mu-plugins/fv-loja.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/setup/configurar-loja.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/setup/configurar-loja.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/setup/conteudo/paginas.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/setup/conteudo/paginas.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/setup/conteudo/produtos.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/setup/conteudo/produtos.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/setup/imagens.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/setup/imagens.php"
			}
		},
		{
			"step": "activateTheme",
			"themeFolderName": "fermento-vivo"
		},
		{
			"step": "setSiteLanguage",
			"language": "pt_BR"
		},
		{
			"step": "wp-cli",
			"command": "wp eval-file /wordpress/setup/configurar-loja.php local"
		},
		{
			"step": "wp-cli",
			"command": "wp rewrite flush"
		}
	]
}
