{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Loja Fermento Vivo · demo",
		"author": "VitoriaMir",
		"description": "Loja WooCommerce com checkout brasileiro, Mercado Pago, Melhor Envio e produtos de exemplo, rodando no navegador."
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "woocommerce"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "melhor-envio-cotacao"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "storefront"
			},
			"options": {
				"activate": false
			}
		},
		{
			"step": "mkdir",
			"path": "/wordpress/setup"
		},
		{
			"step": "mkdir",
			"path": "/wordpress/setup/conteudo"
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/mu-plugins"
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/mu-plugins/fv-loja"
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/mu-plugins/fv-loja/assets"
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/themes/fermento-vivo"
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/themes/fermento-vivo/assets/css"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/themes/fermento-vivo/assets/css/loja.css",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/themes/fermento-vivo/assets/css/loja.css"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/themes/fermento-vivo/functions.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/themes/fermento-vivo/functions.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/themes/fermento-vivo/style.css",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/themes/fermento-vivo/style.css"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/fv-loja/ambiente-local.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/VitoriaMir/loja-woocommerce/main/wp-content/mu-plugins/fv-loja/ambiente-local.php"
			}
		},
		{
